<?php
// Production environment configuration for Hostinger
// Save as: .env (in root directory)

// Database Configuration (Update with your Hostinger database details)
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user  
DB_PASS=your_database_password
DB_PORT=3306

// Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

// Timezone Configuration
APP_TIMEZONE=Asia/Manila

// Mail Configuration (Update with your email settings)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=your_email@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls

// Security Keys (Generate new ones for production)
APP_KEY=base64:your_32_character_random_key_here
ENCRYPTION_KEY=your_encryption_key_here

// File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/public_html/uploads/

// Leave Accrual Settings
LEAVE_ACCRUAL_ENABLED=true
SICK_LEAVE_MONTHLY=0.42
VACATION_LEAVE_MONTHLY=1.25

// Cron Job Settings
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Manila
CRON_LOG_PATH=/public_html/logs/cron.log

// Error Reporting (Production)
ERROR_REPORTING=false
LOG_ERRORS=true
LOG_PATH=/public_html/logs/errors.log
?>