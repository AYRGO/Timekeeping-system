                    // Fetch current weekly schedule for employee
                    $weeklySched = $pdo->prepare("SELECT * FROM employee_default_schedules WHERE employee_id = ? LIMIT 1");
                    $weeklySched->execute([$employeeId]);
                    $weekly = $weeklySched->fetch(PDO::FETCH_ASSOC);
                    $days = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
                    // Get all work schedules
                    $allSchedules = $pdo->query("SELECT id, name, time_in, time_out FROM work_schedules ORDER BY id")->fetchAll(PDO::FETCH_ASSOC);
                    ?>
                    <form method="post" class="space-y-4">
                        <input type="hidden" name="action" value="update_weekly_schedule">
