                <script>
                function openOverride_admin(date) {
                    const input = document.getElementById('override_date');
                    if (input) {
                        input.value = date;
                        input.scrollIntoView({behavior:'smooth', block:'center'});
                        input.focus();
                    }
                }
                </script>
